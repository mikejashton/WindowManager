<ContentView x:Class="WindowManager.Views.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border BackgroundColor="#2D2D30" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto">
            <Label Grid.Row="0"
                   Text="Workspaces"
                   TextColor="White"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,0,0,10"/>
            <!-- TODO: Add workspace list (CollectionView) here -->
            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout/>
            </ScrollView>
            <Button Grid.Row="2"
                    Text="+ New Workspace"
                    Padding="5"
                    Margin="0,5,0,0"/>
        </Grid>
    </Border>
</ContentView>
