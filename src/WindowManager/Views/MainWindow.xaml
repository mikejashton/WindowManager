<ContentPage x:Class="WindowManager.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WindowManager.Views.Controls"
             Title="Window Manager"
             BackgroundColor="#1E1E1E">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <controls:SidebarControl Grid.Column="0"/>

        <!-- Main Content Area Placeholder -->
        <Border Grid.Column="1" BackgroundColor="#1E1E1E">
            <Label Text="Select a window to manage"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="#888888"
                   FontSize="18"/>
        </Border>
    </Grid>
</ContentPage>
