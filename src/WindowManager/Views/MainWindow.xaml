<ContentPage x:Class="WindowManager.Views.MainWindow"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:WindowManager.Views.Controls"
             xmlns:converters="clr-namespace:WindowManager.Converters"
             Title="Window Manager"
             BackgroundColor="#1E1E1E">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ByteArrayToImageSourceConverter x:Key="BytesToImageSource"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <controls:SidebarControl Grid.Column="0"/>

        <!-- Right pane: visible top-level windows -->
        <Border Grid.Column="1" BackgroundColor="#1E1E1E" Padding="12">
            <Grid>
                <Grid IsVisible="{Binding ShouldShowWindowList}" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <Label Grid.Column="0"
                               Text="Select a Window"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="Refresh"
                                Clicked="OnRefreshWindowsClicked"/>
                    </Grid>

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding TopLevelWindows}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedTopLevelWindow, Mode=TwoWay}">
                        <CollectionView.EmptyView>
                            <Label Text="No top-level windows found"
                                   TextColor="#888888"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="10" Stroke="#3A3A3A" StrokeThickness="1">
                                    <Grid ColumnDefinitions="160,*" ColumnSpacing="10">
                                        <!-- Screenshot thumbnail -->
                                        <Border Grid.Column="0"
                                                BackgroundColor="#2A2A2A"
                                                Stroke="#3A3A3A"
                                                StrokeThickness="1"
                                                HeightRequest="90"
                                                WidthRequest="160">
                                            <Image Source="{Binding Screenshot, Converter={StaticResource BytesToImageSource}}"
                                                   Aspect="AspectFit"
                                                   HeightRequest="90"
                                                   WidthRequest="160"/>
                                        </Border>
                                        <!-- Window info -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" TextColor="White" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding ProcessName}" TextColor="#B0B0B0" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding ShowWindowListPlaceholder}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="8">
                    <Label Text="Workspace"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding WindowListPlaceholderText}"
                           TextColor="#A0A0A0"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
